<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/llContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="10dp">

    <!-- 1. Checkbox -->
    <ImageView
        android:id="@+id/ivSelect"
        android:tag="binding_1"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:src="@drawable/ic_radio_checked" />

    <!-- 2. Left Icon (Theme Asset Icon) -->
    <LinearLayout
        android:id="@+id/llNewIconContainer"
        android:layout_width="64dp"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <ImageView
                android:id="@+id/ivNewIcon"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:scaleType="fitCenter"
                android:layout_gravity="center"
                tools:src="@drawable/bg_default_placeholder" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvThemeIconName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:fontFamily="@font/helvetica_bold"
            android:textSize="11sp"
            tools:text="Calculator" />
    </LinearLayout>

    <!-- 3. Arrow Divider -->
    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp"
        android:src="@drawable/ic_arrow_right"
        app:tint="@color/text_primary" />

    <!-- 4. Right Icon (Device App Icon with Edit Badge) -->
    <LinearLayout
        android:id="@+id/llOldIcon"
        android:layout_width="64dp"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <ImageView
                android:id="@+id/ivOldIcon"
                android:tag="binding_2"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/bg_default_placeholder"
                android:scaleType="fitCenter"
                android:layout_gravity="center" />

            <ImageView
                android:id="@+id/ivAdd"
                android:tag="binding_3"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_add"
                android:visibility="gone"
                app:tint="@color/text_secondary" />

            <ImageView
                android:id="@+id/ivEditBadge"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="top|end"
                android:src="@drawable/ic_edit"
             />
        </FrameLayout>

        <TextView
            android:id="@+id/etAppName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:fontFamily="@font/helvetica_bold"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            tools:text="Calculator" />
    </LinearLayout>

    <!-- 5. Spacer -->
    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1" />

    <!-- 6. Action Button (Unlock / Install) -->
    <FrameLayout
        android:id="@+id/btnAction"
        android:layout_width="110dp"
        android:layout_height="40dp"
        android:background="@drawable/btn_outline_pill"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/tvActionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="@string/unlock"
            android:textColor="@color/brand_primary"
            android:textSize="14sp"
            android:fontFamily="@font/helvetica_medium" />
    </FrameLayout>

    <!-- Legacy hidden views for compatibility -->
    <include
        android:id="@+id/unlockView"
        layout="@layout/item_unlock_view"
        android:visibility="gone" />

<!--    <LinearLayout-->
<!--        android:id="@+id/llInstall"-->
<!--        android:layout_width="0dp"-->
<!--        android:layout_height="0dp"-->
<!--        android:visibility="gone" />-->

<!--    <LinearLayout-->
<!--        android:id="@+id/llDownload"-->
<!--        android:layout_width="0dp"-->
<!--        android:layout_height="0dp"-->
<!--        android:visibility="gone" />-->

</LinearLayout>