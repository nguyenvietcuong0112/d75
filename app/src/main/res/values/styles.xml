<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Custom Text Styles -->
    <style name="TitleTextView" parent="Widget.AppCompat.TextView">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Custom Dialog & BottomSheet Themes -->
    <style name="CustomBottomSheetDialogTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/CustomBottomSheetStyle</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <style name="CustomBottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>

    <!-- Keyboard Base Styles -->
    <style name="Keyboard">
        <item name="android:keyBackground">@drawable/btn_keyboard_key_lxx_base</item>
    </style>

    <style name="Keyboard.LXX">
        <item name="android:keyBackground">@drawable/btn_keyboard_key_lxx_base</item>
    </style>

    <style name="KeyboardView" parent="Keyboard">
        <item name="android:background">@color/keyboard_background_lxx_base</item>
    </style>

    <style name="KeyboardView.LXX">
        <item name="android:background">@color/keyboard_background_lxx_base</item>
    </style>

    <style name="AppTheme.AdAttribution" parent="android:Widget">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">left</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">10sp</item>
        <item name="android:text">Ad</item>
        <item name="android:background">@color/black</item>
        <item name="android:width">18dp</item>
        <item name="android:height">18dp</item>
    </style>
</resources>
