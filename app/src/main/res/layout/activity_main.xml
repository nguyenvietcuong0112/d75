<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main">

    <!-- Top Header Bar -->
    <RelativeLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/header_title_theme"
                android:textColor="#FF5678"
                android:textSize="24sp"
                android:textStyle="bold"
                android:fontFamily="@font/fredoka_bold" />

            <TextView
                android:id="@+id/tvHeaderSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/header_subtitle_main"
                android:textColor="@color/text_primary"
                android:textSize="12.5sp"
                android:fontFamily="@font/inter_medium" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/btnPremium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_header_premium"
                android:visibility="gone"
                android:contentDescription="Premium"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <ImageView
                android:id="@+id/btnSetting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:src="@drawable/ic_header_setting"
                android:contentDescription="Settings"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless" />
        </LinearLayout>
    </RelativeLayout>

    <!-- ViewPager2 for the 5 Tabs -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewpager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/headerLayout"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Custom Floating Pill Bottom Navigation Bar (No Material Components) -->
    <LinearLayout
        android:id="@+id/customBottomNav"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginHorizontal="8dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_custom_bottom_nav"
        android:elevation="8dp"
        android:outlineAmbientShadowColor="@color/nav_shadow_pink"
        android:outlineSpotShadowColor="@color/nav_shadow_pink"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:weightSum="5"
        app:layout_constraintBottom_toTopOf="@+id/bannerContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 1. Theme Tab -->
        <LinearLayout
            android:id="@+id/tabTheme"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivNavTheme"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_nav_theme_true" />

            <TextView
                android:id="@+id/tvNavTheme"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/inter_semi_bold"
                android:text="@string/tab_theme"
                android:textColor="@color/nav_item_text_color"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 2. Icons Tab -->
        <LinearLayout
            android:id="@+id/tabIcons"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivNavIcons"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_nav_icons_false" />

            <TextView
                android:id="@+id/tvNavIcons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/inter_semi_bold"
                android:text="@string/tab_icons"
                android:textColor="@color/nav_item_text_color"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 3. Control Tab -->
        <LinearLayout
            android:id="@+id/tabControl"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivNavControl"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_nav_control_false" />

            <TextView
                android:id="@+id/tvNavControl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/inter_semi_bold"
                android:text="@string/tab_control"
                android:textColor="@color/nav_item_text_color"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 4. Widget Tab -->
        <LinearLayout
            android:id="@+id/tabWidget"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivNavWidget"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_nav_widget_false" />

            <TextView
                android:id="@+id/tvNavWidget"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/inter_semi_bold"
                android:text="@string/tab_widget"
                android:textColor="@color/nav_item_text_color"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 5. Collections Tab -->
        <LinearLayout
            android:id="@+id/tabCollections"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivNavCollections"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_nav_collections_false" />

            <TextView
                android:id="@+id/tvNavCollections"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/inter_semi_bold"
                android:text="@string/tab_collections"
                android:textColor="@color/nav_item_text_color"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Collapsible Banner Container -->
    <FrameLayout
        android:id="@+id/bannerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Collapsible Native Container (Floats/docks at bottom with elevation) -->
    <FrameLayout
        android:id="@+id/layoutAds"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="12dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>