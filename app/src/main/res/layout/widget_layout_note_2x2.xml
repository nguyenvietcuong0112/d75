<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="0dp">

    <ImageView
        android:id="@+id/ivBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvNoteText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textAlignment="center"
            android:text="Good morning,\n sunshine! ☀️🍓\nA brand-new day is here, so take a deep breath, smile, and enjoy all the little happy moments. Wishing you a sweet, cozy, and wonderful day ahead! 💕✨"
            android:textColor="#555555"
            android:textSize="11sp"
            android:lineSpacingExtra="3.5dp"
            android:ellipsize="end"
            android:maxLines="6"
            android:layout_marginBottom="16dp"
            android:includeFontPadding="false" />
    </FrameLayout>
</FrameLayout>
